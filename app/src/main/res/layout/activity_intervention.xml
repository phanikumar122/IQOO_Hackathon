<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout notes worth keeping:
  - Scrollable, because a long reason list on a small phone must not push the
    Hang up button off screen.
  - Hang up is first in reading order and visually heaviest. The safe action
    should be the one a panicking thumb finds without aiming.
  - "Continue anyway" is styled down, but present. Delay, never deny.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intervene_headline"
            android:textAppearance="@style/TextAppearance.Prahari.Headline" />

        <TextView
            android:id="@+id/subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intervene_subhead"
            android:textAppearance="@style/TextAppearance.Prahari.Subhead" />

        <!-- Caller, call length, amount. Populated at runtime and hidden if we
             have none of the three. This is the line that makes the screen feel
             like it is about *this* call rather than a generic warning, and it is
             also the line a sceptical user checks first: if it says eleven minutes
             and they have been talking for eleven minutes, the rest is credible. -->
        <TextView
            android:id="@+id/contextLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Prahari.Footer"
            android:visibility="gone" />

        <!-- Populated at runtime, ordered heaviest signal first. -->
        <LinearLayout
            android:id="@+id/reasonList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/behaviourOnlyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/behaviour_only_note"
            android:textAppearance="@style/TextAppearance.Prahari.Footer"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/intervene_footer"
            android:textAppearance="@style/TextAppearance.Prahari.Footer" />

        <!-- The privacy line belongs on this screen, not only in onboarding. This
             is the one moment the user is being told something alarming by an app
             that watched their call, and the honest answer to the question that
             raises should be on the same screen as the alarm. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/intervene_privacy"
            android:textAppearance="@style/TextAppearance.Prahari.Footer" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hangUp"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/prahari_safe"
            android:text="@string/action_hang_up"
            android:textColor="@color/prahari_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/callTrusted"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/action_call_someone"
            android:textColor="@color/prahari_white"
            android:textSize="17sp" />

        <!-- Text is set from code: it carries a live countdown. Muted on purpose —
             present, findable, and clearly the lesser of the three. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/proceed"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/prahari_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
